{
  "name": "@bitspark/slang-design",
  "version": "0.2.1",
  "description": "The shared visual language for Slang websites, studios and applications.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bitspark/slang-design.git"
  },
  "homepage": "https://bitspark.github.io/slang-design/",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./components/index.d.ts",
      "default": "./components/index.js"
    },
    "./styles.css": "./styles/index.css",
    "./tokens.css": "./styles/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./logo/*": "./assets/logo/*"
  },
  "files": [
    "components",
    "styles",
    "tokens",
    "assets",
    "docs",
    "NOTICE",
    "LICENSE"
  ],
  "sideEffects": [
    "./components/index.js",
    "./styles/*.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5176",
    "build": "node scripts/tokens.mjs --check && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5176",
    "tokens": "node scripts/tokens.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run format:check && npm test && npm run build && npm pack --dry-run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-slab": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "prettier": "3.9.8",
    "vite": "8.3.0"
  }
}
